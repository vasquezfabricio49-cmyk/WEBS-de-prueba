{
  "folders": [{"path": "restaurante-demo"}],
  "settings": {
    "remote.autoForwardPorts": true,
    "remote.portsAttributes": {
      "3002": {"label": "Restaurante demo", "onAutoForward": "notify"}
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [{
      "label": "Restaurante: arrancar",
      "type": "shell",
      "command": "python3 server.py --host 0.0.0.0 --port 3002",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }]
  }
}
